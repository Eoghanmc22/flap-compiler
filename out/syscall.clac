: comment Compiled using Eoghan's flap to clac compiler https://github.com/Eoghanmc22/flap-compiler ;

: comment flap source code:
    const int PROT_EXEC = 4;
    const int PROT_READ = 1;
    const int PROT_WRITE = 2;
    const int PROT_NONE = 0;
    
    const int MAP_PRIVATE = 2;
    const int MAP_ANON = 32;
    
    const int NULL = 0;
    
    int mmap(int addr, int length, int prot, int flags, int fd, int pgoffset) {
      syscall(pgoffset, fd, flags, prot, length, addr, 0x09)
    }
    
    int write(int fd, int buf, int count) {
      syscall(0, 0, 0, count, buf, fd, 1)
    }
    
    int page = mmap(NULL, 4096, PROT_READ + PROT_WRITE, MAP_PRIVATE + MAP_ANON, -1, 0);
    write8(104, page);
    write8(101, page+1);
    write8(108, page+2);
    write8(108, page+3);
    write8(111, page+4);
    write8(32, page+5);
    write8(119, page+6);
    write8(111, page+7);
    write8(114, page+8);
    write8(108, page+9);
    write8(100, page+10);
    write8(33, page+11);
    write8(10, page+12);
    
    write(1, page, 13);
;

