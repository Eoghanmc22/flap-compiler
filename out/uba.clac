: comment Compiled using Eoghan's flap to clac compiler https://github.com/Eoghanmc22/flap-compiler ;

: comment flap source code:
    #include "../std"
    
    list_int *list = list_int_new(2);
    
    print((int)list->data);
    new_line();
    
    list_int_push(list, 1);
    list_int_push(list, 5);
    list_int_push(list, 2);
    list_int_push(list, 1);
    list_int_push(list, 3);
    
    list_int_print(list);
    
    new_line();
    print((int)list->data);
    
    new_line();
    new_line();
    
    print(list_int_pop(list));
    print(list_int_pop(list));
    
    new_line();
    new_line();
    
    list_int_push(list, 6);
    list_int_push(list, 7);
    list_int_print(list);
    
    quit();
;

: comment Check that the clac interperter is using the correct native width ;
64 width_native - if -100 print quit

