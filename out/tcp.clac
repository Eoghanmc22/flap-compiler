: comment Compiled using Eoghan's flap to clac compiler https://github.com/Eoghanmc22/flap-compiler ;

: comment flap source code:
    #include "../std"
    
    const int BUFFER_SIZE = 4096;
    const int PORT = 8080;
    
    char *scratch = malloc(BUFFER_SIZE);
    char *buf = malloc(BUFFER_SIZE);
    
    *buf = "hi from clac over TCP!\n";
    
    // Create Socket
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    
    // Allow Socket Reuse
    *((int *)scratch) = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, scratch, int_width());
    
    // Configure server address
    *(scratch + 0) = (char)AF_INET;
    *(scratch + 1) = (char)0;
    *(scratch + 2) = (char)(PORT >> 8);
    *(scratch + 3) = (char)(PORT & 0xFF);
    *(scratch + 4) = (char)0;
    *(scratch + 5) = (char)0;
    *(scratch + 6) = (char)0;
    *(scratch + 7) = (char)0;
    *(scratch + 8) = (char)0;
    *(scratch + 9) = (char)0;
    *(scratch + 10) = (char)0;
    *(scratch + 11) = (char)0;
    *(scratch + 12) = (char)0;
    *(scratch + 13) = (char)0;
    *(scratch + 14) = (char)0;
    *(scratch + 15) = (char)0;
    
    bind(server_fd, (sockaddr *)scratch, 16);
    listen(server_fd, 3);
    
    void loop(int server_fd, char *scratch, char *buf) {
      int client_fd = accept(server_fd, (sockaddr *)NULL, (int *)NULL);
    
      write_all(client_fd, buf, 23);
      close(client_fd);
    
      loop(server_fd, scratch, buf);
    }
    
    loop(server_fd, scratch, buf);
;

: comment Check that the clac interperter is using the correct native width ;
64 width_native - if -100 print quit

