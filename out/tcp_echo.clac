: comment Compiled using Eoghan's flap to clac compiler https://github.com/Eoghanmc22/flap-compiler ;

: comment flap source code:
    #include "../std"
    
    const int BUFFER_SIZE = 4096;
    const int PORT = 8080;
    
    char *scratch = (char *)malloc(BUFFER_SIZE);
    char *buf = (char *)malloc(BUFFER_SIZE);
    
    // Create Socket
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    
    // Allow Socket Reuse
    *((int *)scratch) = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, scratch, int_width());
    
    // Configure server address
    *(scratch + 0) = (char)AF_INET;
    *(scratch + 1) = (char)0;
    *(scratch + 2) = (char)(PORT >> 8);
    *(scratch + 3) = (char)(PORT & 0xFF);
    *(scratch + 4) = (char)0;
    *(scratch + 5) = (char)0;
    *(scratch + 6) = (char)0;
    *(scratch + 7) = (char)0;
    *(scratch + 8) = (char)0;
    *(scratch + 9) = (char)0;
    *(scratch + 10) = (char)0;
    *(scratch + 11) = (char)0;
    *(scratch + 12) = (char)0;
    *(scratch + 13) = (char)0;
    *(scratch + 14) = (char)0;
    *(scratch + 15) = (char)0;
    
    bind(server_fd, (sockaddr *)scratch, 16);
    listen(server_fd, 3);
    
    void client_loop(int client_fd, char *buf) {
      if (copy(buf, BUFFER_SIZE, client_fd, client_fd) != 0) {
        client_loop(client_fd, buf);
      }
    }
    
    void loop(int server_fd, char *buf) {
      int client_fd = accept(server_fd, (sockaddr *)NULL, (int *)NULL);
    
      if (fork() == 0) {
        client_loop(client_fd, buf);
        close(client_fd);
    
        quit();
      }
    
      close(client_fd);
    
      loop(server_fd, buf);
    }
    
    loop(server_fd, buf);
;

: comment Check that the clac interperter is using the correct native width ;
64 width_native - if -100 print quit

