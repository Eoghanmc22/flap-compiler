#include "constants.flap"

int strlen(char *str) {
  if (*str == '\0') {
    0
  } else {
    1 + strlen(str + 1)
  }
}

char *split_str(char *str, char c) {
  char cur = *str;
  if (cur == '\0') {
    (char *)NULL
  } else if (cur == c) {
    *str = '\0';
    str + 1
  } else {
    split_str(str + 1, c)
  }
}

int strcmp(char *a, char *b) {
  int inner(char *a, char *b) {
    int difference = (int)*a - (int)*b;

    if (difference == 0) {
      if (*a == (char)0) {
        0
      } else {
        strcmp(a + 1, b + 1)
      }
    } else {
      difference
    }
  }

  if (a == NULL && b == NULL) {
    0
  } else if (a == NULL) {
    -1
  } else if (b == NULL) {
    1
  } else {
    inner(a, b)
  }
}

char *strcpy(char *dst, char *src) {
  *dst = *src;

  if (*src != (char)0) {
    strcpy(dst + 1, src + 1)
  } else {
    dst
  }
}
