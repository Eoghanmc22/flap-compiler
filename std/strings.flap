#include "constants.flap"


typedef struct {
  bool success;
  int result;
} atoi_result;

atoi_result atoi(char *str) {
  atoi_result inner(int n, char *st) {
    int d = (int)*st;
    if (d == 0) {
      struct {
        result = n;
        success = true;
      }
    } else {
      int x = d - (int)'0';

      if (x >= 0 && (x < 10)) {
        inner(n * 10 + x, st + 1)
      } else {
        struct {
          success = false;
          result = 0;
        }
      }
    }
  }

  if (*str == '-') {
    atoi_result res = inner(0, str + 1);
    struct {
      success = res.success;
      result = -res.result;
    }
  } else {
    inner(0, str)
  }
}


int strlen(char *str) {
  int i = 0;

  while (str[i] != '\0') {
    i = i + 1;
  }

  i
}

char *split_str(char *str, char c) {
  while (*str != '\0' && *str != c) {
    str = str + 1;
  }

  if (*str == c) {
    *str = '\0';
    str + 1
  } else {
    NULL
  }
}

int strcmp(char *a, char *b) {
  if (a == NULL || b == NULL) {
    (int)(a != NULL) - (int)(b != NULL)
  } else {
    while (*a != (char)0 && (*a == *b)) {
      a = a + 1;
      b = b + 1;
    }

    (int)(*a - *b)
  }
}

char *strcpy(char *dst, char *src) {
  *dst = *src;

  while (*src != (char)0) {
    dst = dst + 1;
    src = src + 1;
    *dst = *src;
  }

  dst
}
