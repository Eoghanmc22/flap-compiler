#include "constants.flap"

int strlen(char *str) {
  int i = 0;

  while (str[i] != '\0') {
    i = i + 1;
  }

  i
}

char *split_str(char *str, char c) {
  while (*str != '\0' && *str != c) {
    str = str + 1;
  }

  if (*str == c) {
    *str = '\0';
    str + 1
  } else {
    NULL
  }
}

int strcmp(char *a, char *b) {
  if (a == NULL || b == NULL) {
    (int)(a != NULL) - (int)(b != NULL)
  } else {
    while (*a != (char)0 && (*a == *b)) {
      a = a + 1;
      b = b + 1;
    }

    (int)(*a - *b)
  }
}

char *strcpy(char *dst, char *src) {
  *dst = *src;

  while (*src != (char)0) {
    dst = dst + 1;
    src = src + 1;
    *dst = *src;
  }

  dst
}
