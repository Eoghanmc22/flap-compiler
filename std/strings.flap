#include "io.flap"
#include "malloc.flap"
#include "memory.flap"

int strlen(char *str) {
  if (*str == '\0') {
    0
  } else {
    1 + strlen(str + 1)
  }
}

char *strdup(char *str) {
  int len = strlen(str);
  char *new = (char *)malloc(len);
  memcpy(new, str, len + 1); // include null byte
  new
}

void print_str(char *str) {
  if (str != (char *)NULL) {
    int len = strlen(str);

    write_all(STDOUT, str, len);
    new_line();
  } else {
    char[12] error = "str = NULL\n\0";

    char *page = (char *)malloc(sizeof(error));
    *page = error;

    write_all(STDOUT, page, sizeof(error));

    free((void *)page);
  }
}
