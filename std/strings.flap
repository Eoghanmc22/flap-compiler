#include "assert.flap"
#include "io.flap"
#include "malloc.flap"
#include "memory.flap"

typedef struct {
  bool success;
  int result;
} atoi_result;

atoi_result atoi(char *str) {
  atoi_result inner(int n, char *st) {
    int d = (int)*st;
    if (d == 0) {
      struct {
        result = n;
        success = true;
      }
    } else {
      int x = d - (int)'0';

      if (x >= 0 && (x < 10)) {
        inner(n * 10 + x, st + 1)
      } else {
        struct {
          success = false;
          result = 0;
        }
      }
    }
  }

  if (*str == '-') {
    atoi_result res = inner(0, str + 1);
    struct {
      success = res.success;
      result = -res.result;
    }
  } else {
    inner(0, str)
  }
}

int strlen(char *str) {
  if (*str == '\0') {
    0
  } else {
    1 + strlen(str + 1)
  }
}

char *strdup(char *str) {
  int len = strlen(str);
  char *new = (char *)malloc(len);
  memcpy(new, str, len + 1); // include null byte
  new
}

void print_str(char *str) {
  if (str != (char *)NULL) {
    int len = strlen(str);

    write_all(STDOUT, str, len);
    new_line();
  } else {
    auto error = "str = NULL\n\0";

    char *page = (char *)malloc(sizeof_packed(error));
    *page = error;

    write_all(STDOUT, page, sizeof_packed(error));

    free((void *)page);
  }
}
