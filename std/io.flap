#include "malloc.flap"
#include "strings.flap"
#include "syscall.flap"

int read_all(int fd, char *buf, int count) {
  int in = read(fd, buf, count);
  int read = in;

  while (in > 0) {
    in = read(fd, buf + read, count - read);
    read = read + in;
  }

  read
}

typedef struct {
  char *data;
  int len;
} read_all2_result;

read_all2_result read_all2(int fd) {
  int len = 4096;
  char *buf = malloc(len);

  int read = read_all(fd, buf, len);

  while (read == len) {
    len = len * 2;
    buf = realloc(buf, len);

    read = read + read_all(fd, buf + read, len - read);
  }

  buf = realloc(buf, read);

  struct {
    data = buf;
    len = read;
  }
}

int write_all(int fd, char *buf, int count) {
  int out = write(fd, buf, count);
  int written = out;

  while (out > 0) {
    out = write(fd, buf + written, count - written);
    written = written + out;
  }

  written
}

int copy_all(char *buf, int buf_len, int src_fd, int dst_fd) {
  int in = read_all(src_fd, buf, buf_len);
  int read = in;

  while (in > 0) {
    write_all(dst_fd, buf, in);
    in = read_all(src_fd, buf, buf_len);
    read = read + in;
  }

  read
}

int copy(char *buf, int buf_len, int src_fd, int dst_fd) {
  int in = read(src_fd, buf, buf_len);
  int read = in;

  while (in > 0) {
    write_all(dst_fd, buf, in);
    in = read(src_fd, buf, buf_len);
    read = read + in;
  }

  read
}

void print_new_line() {
  char *new_line = malloc(1);
  *new_line = "\n";
  write(STDOUT, new_line, 1);

  free(new_line);
}

void print_str(char *str) {
  if (str != (char *)NULL) {
    int len = strlen(str);

    write_all(STDOUT, str, len);
    print_new_line();
  } else {
    auto error = "str = NULL\n\0";

    char *page = malloc(sizeof_packed(error));
    *page = error;

    write_all(STDOUT, page, sizeof_packed(error));

    free(page);
  }
}
