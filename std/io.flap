#include "malloc.flap"
#include "strings.flap"
#include "syscall.flap"

int read_all(int fd, char *buf, int count) {
  int new = read(fd, buf, count);

  if (new != 0) {
    new + read_all(fd, buf + new, count - new)
  } else {
    0
  }
}

typedef struct {
  char *data;
  int len;
} read_all2_result;

read_all2_result read_all2(int fd) {
  read_all2_result inner(char *buf, int read, int len) {
    int new = read_all(fd, buf + read, len - read);

    if (read + new >= len) {
      int len = len * 2;
      char *buf = realloc(buf, len);

      inner(buf, read + new, len)
    } else {
      struct {
        data = buf;
        len = read + new;
      }
    }
  }

  int len = 4096;
  char *buf = malloc(len);

  inner(buf, 0, len)
}

int write_all(int fd, char *buf, int count) {
  int new = write(fd, buf, count);

  if (new != 0) {
    new + write_all(fd, buf + new, count - new)
  } else {
    0
  }
}

void copy_all(char *buf, int buf_len, int src_fd, int dst_fd) {
  int in = read_all(src_fd, buf, buf_len);

  if (in > 0) {
    write_all(dst_fd, buf, in);
    copy_all(buf, buf_len, src_fd, dst_fd);
  }
}

int copy(char *buf, int buf_len, int src_fd, int dst_fd) {
  int in = read(src_fd, buf, buf_len);

  if (in > 0) {
    write_all(dst_fd, buf, in);
    in + copy(buf, buf_len, src_fd, dst_fd)
  } else {
    0
  }
}

void print_new_line() {
  char *new_line = malloc(1);
  *new_line = "\n";
  write(STDOUT, new_line, 1);

  free(new_line);
}

void print_str(char *str) {
  if (str != (char *)NULL) {
    int len = strlen(str);

    write_all(STDOUT, str, len);
    print_new_line();
  } else {
    auto error = "str = NULL\n\0";

    char *page = malloc(sizeof_packed(error));
    *page = error;

    write_all(STDOUT, page, sizeof_packed(error));

    free(page);
  }
}
