#include "constants.flap"

// socket apis
const int AF_UNIX = 1;
const int AF_INET = 2;
const int SOCK_STREAM = 1;
const int SOL_SOCKET = 1;
const int SO_REUSEADDR = 2;
const int INADDR_ANY = 0;

// mmap prot
const int PROT_EXEC = 4;
const int PROT_READ = 1;
const int PROT_WRITE = 2;
const int PROT_NONE = 0;

// mmap flags
const int MAP_SHARED = 1;
const int MAP_PRIVATE = 2;
const int MAP_FIXED = 16;
const int MAP_ANONYMOUS = 32;
const int MAP_FIXED_NOREPLACE = 1048576;

// mremap
const int MREMAP_MAYMOVE = 1;
const int MREMAP_FIXED = 2;

// wait
const int WNOHANG = 1;

// clock_gettime
const int CLOCK_REALTIME = 0;
const int CLOCK_MONOTONIC = 1;

const int STDIN = 0;
const int STDOUT = 1;
const int STDERR = 2;

int handle_error(int res) {
  if (res == -1) {
    print(67676767);
    quit();
  }

  res
}

void *mmap(void *addr, int length, int prot, int flags, int fd, int pgoffset) {
  (void *)handle_error(
      syscall(0x09, (int)addr, length, prot, flags, fd, pgoffset))
}

int munmap(void *addr, int length) {
  handle_error(syscall(0x0b, (int)addr, length, 0, 0, 0, 0))
}

void *mremap(void *addr, int old_length, int new_length, int flags,
             void *new_addr) {
  (void *)handle_error(
      syscall(0x19, (int)addr, old_length, new_length, flags, (int)new_addr, 0))
}

int read(int fd, char *buf, int count) {
  handle_error(syscall(0x00, fd, (int)buf, count, 0, 0, 0))
}

int write(int fd, char *buf, int count) {
  handle_error(syscall(0x01, fd, (int)buf, count, 0, 0, 0))
}

int open(char *name, int flags, int mode) {
  handle_error(syscall(0x02, (int)name, flags, mode, 0, 0, 0))
}

int close(int fd) { handle_error(syscall(0x03, fd, 0, 0, 0, 0, 0)) }

int socket(int domain, int type, int protocol) {
  handle_error(syscall(0x29, (int)domain, type, protocol, 0, 0, 0))
}

int setsockopt(int sockfd, int level, int optname, char *optvalue, int optlen) {
  handle_error(syscall(0x36, sockfd, level, optname, (int)optvalue, optlen, 0))
}

typedef void sockaddr;
int bind(int sockfd, sockaddr *addr_struct, int addr_struct_len) {
  handle_error(
      syscall(0x31, sockfd, (int)addr_struct, addr_struct_len, 0, 0, 0))
}

int connect(int sockfd, sockaddr *addr_struct, int addr_struct_len) {
  handle_error(
      syscall(0x2a, sockfd, (int)addr_struct, addr_struct_len, 0, 0, 0))
}

int listen(int sockfd, int backlog) {
  handle_error(syscall(0x32, sockfd, backlog, 0, 0, 0, 0))
}

int accept(int sockfd, sockaddr *addr_struct, int *addr_struct_len) {
  handle_error(
      syscall(0x2b, sockfd, (int)addr_struct, (int)addr_struct_len, 0, 0, 0))
}

typedef struct {
  void *iov1_base;
  int iov2_len;
} iovec;

typedef struct {
  void *msg1_name;
  int msg2_namelen;
  iovec *msg3_iov;
  int msg4_iovlen;
  void *msg5_control;
  int msg6_controllen;
  int msg7_flags;
} msghdr;

typedef struct {
  int cmsg1_len;
  int cmsg2_level_type_PACKED;
} cmsghdr;

int sendmsg(int sockfd, msghdr *msg, int flags) {
  handle_error(syscall(0x2e, sockfd, (int)msg, flags, 0, 0, 0))
}

int recvmsg(int sockfd, msghdr *msg, int flags) {
  handle_error(syscall(0x2f, sockfd, (int)msg, flags, 0, 0, 0))
}

int fork() { handle_error(syscall(0x39, 0, 0, 0, 0, 0, 0)) }

typedef void rusage;
int wait(int pid, int *status, int options, rusage *rusage) {
  handle_error(syscall(0x3d, pid, (int)status, options, (int)rusage, 0, 0))
}

int getrandom(void *buf, int size, int flags) {
  handle_error(syscall(0x13e, (int)buf, size, flags, 0, 0, 0))
}

int memfd_create(char *name, int flags) {
  handle_error(syscall(0x13f, (int)name, flags, 0, 0, 0, 0))
}

int truncate(char *path, int length) {
  handle_error(syscall(0x4c, (int)path, length, 0, 0, 0, 0))
}

int ftruncate(int fd, int length) {
  handle_error(syscall(0x4d, fd, length, 0, 0, 0, 0))
}

int sendto(int fd, char *buffer, int length, int flags, sockaddr *dest_addr, int addr_len) {
  handle_error(syscall(0x2c, fd, (int)buffer, length, flags, (int)dest_addr, addr_len))
}

int send(int fd, char *buffer, int length, int flags) {
  sendto(fd, buffer, length, flags, NULL, 0)
}

int recvfrom(int fd, char *buffer, int length, int flags, sockaddr *dest_addr, int *addr_len) {
  handle_error(syscall(0x2d, fd, (int)buffer, length, flags, (int)dest_addr, (int)addr_len))
}

int recv(int fd, char *buffer, int length, int flags) {
  recvfrom(fd, buffer, length, flags, NULL, NULL)
}

int kill(int pid, int sig) {
  handle_error(syscall(0x3e, pid, sig, 0, 0, 0, 0))
}

typedef struct inorder {
  int tv_sec;
  int tv_nsec;
} timespec;

int clock_gettime(int clock, timespec *ts) {
  handle_error(syscall(0xe4, clock, (int)ts, 0, 0, 0, 0))
}

int nanosleep(timespec *duration, timespec *out_rem) {
  handle_error(syscall(0x23, (int)duration, (int)out_rem, 0, 0, 0, 0))
}
