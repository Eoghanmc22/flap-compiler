#include "malloc.flap"
#include "memory.flap"

typedef int list_int_value;

typedef struct {
  list_int_value *data;
  int len;
  int cap;
} list_int;

list_int *list_int_new(int cap) {
  list_int *header = malloc(sizeof<list_int>);

  header->data = malloc(cap * sizeof<list_int_value>);
  header->cap = cap;
  header->len = 0;

  header
}

void list_int_free(list_int *list) {
  free(list->data);
  free(list);
}

void list_int_push(list_int *list, list_int_value value) {
  if (list->len == list->cap) {
    int new_cap = list->cap * 2;

    list->data = realloc(list->data, new_cap * sizeof<list_int_value>);

    list->cap = new_cap;
  }

  list->data[list->len] = value;
  list->len = list->len + 1;
}

list_int_value list_int_pop(list_int *list) {
  list->len = list->len - 1;
  list->data[list->len]
}

void list_int_print(list_int *list) {
  for (int i = 0; i < list->len; i = i + 1) {
    print((int)list->data[i]);
  }
}
