#include "malloc.flap"
#include "memory.flap"

typedef int list_int_value;

typedef struct {
  list_int_value *data;
  int len;
  int cap;
} list_int;

list_int *list_int_new(int cap) {
  list_int *header = (list_int *)malloc(sizeof<list_int>);

  header->data = (list_int_value *)malloc(cap * sizeof<list_int_value>);
  header->cap = cap;
  header->len = 0;

  header
}

void list_int_free(list_int *list) {
  free((void *)list->data);
  free((void *)list);
}

void list_int_push(list_int *list, list_int_value value) {
  if (list->len == list->cap) {
    int new_cap = list->cap * 2;
    list->data = (list_int_value *)realloc((void *)list->data,
                                           new_cap * sizeof<list_int_value>);

    list->cap = new_cap;
  }

  list->data[list->len] = value;
  list->len = list->len + 1;
}

list_int_value list_int_pop(list_int *list) {
  list->len = list->len - 1;
  list->data[list->len]
}

void list_int_print(list_int *list) {
  void inner(list_int * list, int idx) {
    if (idx < list->len) {
      print((int)list->data[idx]);
      inner(list, idx + 1);
    }
  }

  inner(list, 0);
}
