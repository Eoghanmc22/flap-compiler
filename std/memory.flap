#include "syscall.flap"

#[lang]
void map_global(void *at, int size) {
  const int prot = PROT_READ + PROT_WRITE;
  const int flags = MAP_PRIVATE + MAP_ANONYMOUS + MAP_FIXED_NOREPLACE;

  mmap(at, size, prot, flags, -1, 0);
}

void memcpy_int(int *dst, int *src, int len) {
  for (int i = 0; i < len; i = i + 1) {
    dst[i] = src[i];
  }
}

void memcpy_char(char *dst, char *src, int len) {
  for (int i = 0; i < len; i = i + 1) {
    dst[i] = src[i];
  }
}
