#include "malloc.flap"
#include "memory.flap"
#include "strings.flap"

typedef char *list_string_value;

typedef struct {
  list_string_value *data;
  int len;
  int cap;
} list_string;

list_string *list_string_new(int cap) {
  list_string *header = (list_string *)malloc(sizeof<list_string>);

  header->data = (list_string_value *)malloc(cap * sizeof<list_string_value>);
  header->cap = cap;
  header->len = 0;

  header
}

void list_string_push(list_string *list, list_string_value value) {
  if (list->len == list->cap) {
    int new_cap = list->cap * 2;
    list_string_value *new_data =
        (list_string_value *)malloc(new_cap * sizeof<list_string_value>);

    memcpy((int *)list->data, (int *)new_data, list->len);

    list->data = new_data;
    list->cap = new_cap;
  }

  list->data[list->len] = value;
  list->len = list->len + 1;
}

list_string_value list_string_pop(list_string *list) {
  list->len = list->len - 1;
  list->data[list->len]
}

void list_string_print(list_string *list) {
  void inner(list_string * list, int idx) {
    if (idx < list->len) {
      print_str(list->data[idx]);
      inner(list, idx + 1);
    }
  }

  inner(list, 0);
}
