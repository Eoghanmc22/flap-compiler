#include "list_string.flap"

list_string *parse_args() {
  void inner(list_string * parsed, char *buf, char *last_ptr, int len) {
    if (len == 0) {
      // NOOP
    } else if ((int)*buf == 0) {
      list_string_push(parsed, last_ptr);
      inner(parsed, buf + 1, buf + 1, len - 1)
    } else {
      inner(parsed, buf + 1, last_ptr, len - 1)
    }
  }

  int len = 4096;
  char *page = malloc(len);

  // Put /proc/self/cmdline into page
  *page = "/proc/self/cmdline\0";

  int cmdline_fd = open(page, 0, 0);
  int cmdline_len = read_all(cmdline_fd, page, len);
  close(cmdline_fd);

  list_string *parsed = list_string_new(10);
  inner(parsed, page, page, cmdline_len);

  parsed
}
