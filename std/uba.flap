#include "malloc.flap"
#include "memory.flap"

typedef struct {
  int *data;
  int len;
  int cap;
} list_int;

list_int *list_int_new(int cap) {
  list_int *header = (list_int *)malloc(sizeof<list_int>);

  header->data = (int *)malloc(cap * sizeof<int>);
  header->cap = cap;
  header->len = 0;

  header
}

void list_int_push(list_int *list, int value) {
  if (list->len == list->cap) {
    int new_cap = list->cap * 2;
    int *new_data = (int *)malloc(new_cap * sizeof<int>);

    memcpy(list->data, new_data, list->len);

    list->data = new_data;
    list->cap = new_cap;
  }

  list->data[list->len] = value;
  list->len = list->len + 1;
}

int list_int_pop(list_int *list) {
  list->len = list->len - 1;
  list->data[list->len]
}

void list_int_print(list_int *list) {
  void inner(list_int *list, int idx) {
    if (idx < list->len) {
      print(list->data[idx]);
      inner(list, idx + 1);
    }
  }

  inner(list, 0);
}
