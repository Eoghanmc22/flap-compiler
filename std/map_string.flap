#include "hash.flap"
#include "io.flap"
#include "malloc.flap"
#include "math.flap"
#include "memory.flap"

const int map_string_STATUS_FREE = 0;
const int map_string_STATUS_OCCUPIED = 1;
const int map_string_STATUS_REMOVED = 2;

typedef char *map_string_key;

typedef struct {
  map_string_key key;
  void *value;
  int status;
} map_string_entry;

typedef struct {
  map_string_entry *data;
  int len;
  int cap;
  void *default;
} map_string;

typedef struct {
  map_string *map;
  int idx;
} map_string_iter;

map_string *map_string_new(int log_cap) {
  map_string *header = (map_string *)malloc(sizeof<map_string>);

  int cap = pow(2, log_cap);
  header->data = (map_string_entry *)malloc(cap * sizeof<map_string_entry>);
  header->cap = cap;
  header->len = 0;
  header->default = (void *)0;

  header
}

void map_string_free(map_string *map) {
  free((void *)map->data);
  free((void *)map);
}

map_string_iter *map_string_iter_new(map_string *map) {
  map_string_iter *iter = (map_string_iter *)malloc(sizeof<map_string_iter>);

  iter->map = map;
  iter->idx = 0;

  iter
}

void map_string_iter_free(map_string_iter *iter) { free((void *)iter); }

bool map_string_iter_has_next(map_string_iter *iter) {
  if (iter->map->data[iter->idx].status == map_string_STATUS_OCCUPIED) {
    true
  } else if (iter->idx >= iter->map->cap) {
    false
  } else {
    iter->idx = iter->idx + 1;
    map_string_iter_has_next(iter)
  }
}

map_string_entry map_string_iter_next(map_string_iter *iter) {
  int old_idx = iter->idx;
  iter->idx = old_idx + 1;
  iter->map->data[old_idx]
}

void *map_string_insert(map_string *map, map_string_key key, void *value) {
  void *insert_probe(map_string * map, int start, int iter,
                     map_string_entry entry) {
    int idx = (start + (iter + iter * iter) / 2) % map->cap;

    map_string_entry old = map->data[idx];
    if (old.status != map_string_STATUS_OCCUPIED || old.key == entry.key) {
      map->data[idx] = entry;

      if (old.status == map_string_STATUS_OCCUPIED) {
        old.value
      } else {
        map->default
      }
    } else {
      insert_probe(map, start, iter + 1, entry)
    }
  }

  void extend_from_iter(map_string * dst, map_string_iter * src_iter) {
    if (map_string_iter_has_next(src_iter)) {
      map_string_entry entry = map_string_iter_next(src_iter);
      map_string_insert(dst, entry.key, entry.value);
      extend_from_iter(dst, src_iter);
    }
  }

  if (map->len >= map->cap / 2) {
    map_string *dst = map_string_new(map->cap * 2);
    map_string_iter *iter = map_string_iter_new(map);

    extend_from_iter(dst, iter);
    *map = *dst;
  }

  int start_cell = abs(hash_string(key)) % map->cap;
  map->len = map->len + 1;

  insert_probe(
      map, start_cell, 0, struct {
        key = key;
        value = value;
        status = map_string_STATUS_OCCUPIED;
      })
}

void *map_string_get(map_string *map, map_string_key key) {
  void *get_probe(map_string * map, int start, int iter, map_string_key key) {
    int idx = (start + (iter + iter * iter) / 2) % map->cap;

    map_string_entry entry = map->data[idx];
    if (entry.status == map_string_STATUS_OCCUPIED && entry.key == key) {
      entry.value
    } else if (entry.status == map_string_STATUS_FREE) {
      map->default
    } else {
      get_probe(map, start, iter + 1, key)
    }
  }

  int start_cell = abs(hash_string(key)) % map->cap;
  get_probe(map, start_cell, 0, key)
}

bool map_string_contains(map_string *map, map_string_key key) {
  bool contains_probe(map_string * map, int start, int iter,
                      map_string_key key) {
    int idx = (start + (iter + iter * iter) / 2) % map->cap;

    map_string_entry entry = map->data[idx];
    if (entry.status == map_string_STATUS_OCCUPIED && entry.key == key) {
      true
    } else if (entry.status == map_string_STATUS_FREE) {
      false
    } else {
      contains_probe(map, start, iter + 1, key)
    }
  }

  int start_cell = abs(hash_string(key)) % map->cap;
  contains_probe(map, start_cell, 0, key)
}

bool map_string_remove(map_string *map, map_string_key key) {
  bool remove_probe(map_string * map, int start, int iter, map_string_key key) {
    int idx = (start + (iter + iter * iter) / 2) % map->cap;

    map_string_entry entry = map->data[idx];
    if (entry.status == map_string_STATUS_OCCUPIED && entry.key == key) {
      map->data[idx].status = map_string_STATUS_REMOVED;
      true
    } else if (entry.status == map_string_STATUS_FREE) {
      false
    } else {
      remove_probe(map, start, iter + 1, key)
    }
  }

  int start_cell = abs(hash_string(key)) % map->cap;
  remove_probe(map, start_cell, 0, key)
}

void map_string_print(map_string *map) {
  void inner(map_string_iter * iter) {
    if (map_string_iter_has_next(iter)) {
      map_string_entry entry = map_string_iter_next(iter);

      print((int)entry.key);
      print((int)entry.value);
      print_new_line();

      inner(iter);
    }
  }

  inner(map_string_iter_new(map));
}
