#include "assert.flap"
#include "io.flap"
#include "list_string.flap"
#include "malloc.flap"
#include "map_string.flap"
#include "strings.flap"

list_string *parse_args() {

  // Put /proc/self/cmdline into page
  auto path = "/proc/self/cmdline\0";
  char *page = malloc(sizeof(path));
  *page = path;

  int cmdline_fd = open(page, 0, 0);
  read_all2_result cmdline = read_all2(cmdline_fd);
  close(cmdline_fd);
  free(page);

  list_string *parsed = list_string_new(10);

  void inner(char *buf, char *last_ptr, int len) {
    if (len == 0) {
      // Ret
    } else if ((int)*buf == 0) {
      list_string_push(parsed, last_ptr);
      inner(buf + 1, buf + 1, len - 1)
    } else {
      inner(buf + 1, last_ptr, len - 1)
    }
  }

  inner(cmdline.data, cmdline.data, cmdline.len);
  // Cant free cmdline->data since parsed contains pointers into it

  parsed
}

char *arg_get_positional(list_string *parsed, int idx) {
  char *inner(int idx, int next_idx) {
    if (next_idx >= parsed->len) {
      (char *)NULL
    } else if (*parsed->data[next_idx] == '-') {
      inner(idx, next_idx + 1)
    } else if (idx == 0) {
      parsed->data[next_idx]
    } else {
      inner(idx - 1, next_idx + 1)
    }
  }

  inner(idx, 0)
}

char *arg_get_opt(list_string *parsed, char opt){
  char *inner(int next_idx) {
    if (next_idx >= parsed->len) {
        (char *)NULL
    } else if (*parsed->data[next_idx] == '-') {
      char *option = parsed->data[next_idx];

      if (option[1] == opt) {
        option + 2
      } else {
        inner(next_idx + 1)
      }
    } else {
      inner(next_idx + 1)
    }
  }

  inner(0)
}

map_string *parse_env() {

  // Put /proc/self/environ into page
  auto path = "/proc/self/environ\0";
  char *page = malloc(sizeof(path));
  *page = path;

  int environ_fd = open(page, 0, 0);
  read_all2_result environ = read_all2(environ_fd);
  close(environ_fd);
  free(page);

  map_string *parsed = map_string_new(6); // 2^6

  void inner(char *buf, char *last_ptr, int len) {
    if (len == 0) {
      // Ret
    } else if ((int)*buf == 0) {
      char *key = last_ptr;
      char *value = split_str(last_ptr, '=');

      assert(value != (char *)NULL, __LINE__);

      map_string_insert(parsed, key, value);
      inner(buf + 1, buf + 1, len - 1)
    } else {
      inner(buf + 1, last_ptr, len - 1)
    }
  }

  inner(environ.data, environ.data, environ.len);
  // Cant free environ->data since parsed contains pointers into it

  parsed
}
