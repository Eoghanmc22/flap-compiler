#include "constants.flap"
#include "syscall.flap"

typedef struct {
  int size;
} malloc_block;

void *malloc(int size) {
  const int prot = PROT_READ + PROT_WRITE;
  const int flags = MAP_PRIVATE + MAP_ANONYMOUS;

  int size = size + sizeof<malloc_block>;
  malloc_block *block = mmap(NULL, size, prot, flags, -1, 0);

  *block = struct {
    size = size;
  };

  block + 1
}

void free(void *block) {
  malloc_block *block = (malloc_block *)block - 1;

  munmap(block, block->size);
}

void *realloc(void *block, int size) {
  if (block != NULL) {
    if (size != 0) {
      malloc_block *block = (malloc_block *)block - 1;

      int size = size + sizeof<malloc_block>;
      malloc_block *block = mremap(block, block->size, size, MREMAP_MAYMOVE, NULL);

      *block = struct {
        size = size;
      };

      block + 1
    } else {
      free(block);

      NULL
    }
  } else {
    malloc(size)
  }
}
