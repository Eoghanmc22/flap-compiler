#include "math.flap"
#include "memory.flap"

typedef struct {
  int seed;
} rng;

const rng *RNG_STATE = (rng *)NEXT_GLOBAL;
const char *NEXT_GLOBAL =
    NEXT_GLOBAL + PAGE_SIZE; // roundup_page_size(sizeof<rng>);

void init_rng() {
  map_global(RNG_STATE, sizeof<rng>);
  getrandom(RNG_STATE, sizeof<rng>, 0);
}

int lcg(int x) {
  x * 0xD1342543DE82EF95 + 0x875DD4E5E439C627
}

int rand() {
  RNG_STATE->seed = lcg(RNG_STATE->seed);
  RNG_STATE->seed
}
