#include "list_int.flap"
#include "malloc.flap"

char *convert_int_to_string(int x) {
  list_int *list = list_int_new(10);

  if (x == 0) {
    list_int_push(list, 0);
  } else {
    while (x != 0) {
      list_int_push(list, x % 10);
      x = x / 10;
    }
  }

  int num_digits = list->len;
  char *str = malloc(num_digits + 1);

  for (int i = 0; i < num_digits; i = i + 1) {
    int digit = list_int_pop(list);
    str[i] = (char)digit + '0';
  }
  str[num_digits] = '\0';

  list_int_free(list);

  str
}

char *convert_int_to_hex(int x) {
  list_int *list = list_int_new(10);

  if (x == 0) {
    list_int_push(list, 0);
  } else {
    while (x != 0) {
      list_int_push(list, x % 16);
      x = x / 16;
    }
  }

  int num_digits = list->len;
  char *str = malloc(num_digits + 1);

  for (int i = 0; i < num_digits; i = i + 1) {
    int digit = list_int_pop(list);
    if (digit < 10) {
      str[i] = (char)digit + '0';
    } else {
      str[i] = (char)(digit - 10) + 'A';
    }
  }
  str[num_digits] = '\0';

  list_int_free(list);

  str
}
