const int *wayland_current_id_ptr = (int *)NEXT_GLOBAL;
const char *NEXT_GLOBAL =
    NEXT_GLOBAL + PAGE_SIZE; // roundup_page_size(sizeof<rng>);
map_global(wayland_current_id_ptr, sizeof<int>);

const int wayland_display_object_id = 1;
const int wayland_wl_registry_event_global = 0;
const int wayland_shm_pool_event_format = 0;
const int wayland_wl_buffer_event_release = 0;
const int wayland_xdg_wm_base_event_ping = 0;
const int wayland_xdg_toplevel_event_configure = 0;
const int wayland_xdg_toplevel_event_close = 1;
const int wayland_xdg_surface_event_configure = 0;
const int wayland_wl_display_get_registry_opcode = 1;
const int wayland_wl_registry_bind_opcode = 0;
const int wayland_wl_compositor_create_surface_opcode = 0;
const int wayland_xdg_wm_base_pong_opcode = 3;
const int wayland_xdg_surface_ack_configure_opcode = 4;
const int wayland_wl_shm_create_pool_opcode = 0;
const int wayland_xdg_wm_base_get_xdg_surface_opcode = 2;
const int wayland_wl_shm_pool_create_buffer_opcode = 0;
const int wayland_wl_surface_attach_opcode = 1;
const int wayland_xdg_surface_get_toplevel_opcode = 1;
const int wayland_wl_surface_commit_opcode = 6;
const int wayland_wl_display_error_event = 0;
const int wayland_format_xrgb8888 = 1;
const int wayland_header_size = 8;
const int color_channels = 4;

typedef int state_state_t;
const int STATE_NONE = 0;
const int STATE_SURFACE_ACKED_CONFIGURE = 1;
const int STATE_SURFACE_ATTACHED = 2;

typedef struct {
  int wl_registry;
  int wl_shm;
  int wl_shm_pool;
  int wl_buffer;
  int xdg_wm_base;
  int xdg_surface;
  int wl_compositor;
  int wl_surface;
  int xdg_toplevel;
  int stride;
  int w;
  int h;
  int shm_pool_size;
  int shm_fd;
  char *shm_pool_data;
  char *scratch;
  int scratch_len;

  state_state_t state;
} state_t;

int next_wayland_id() {
  int next = *wayland_current_id_ptr + 1;
  *wayland_current_id_ptr = next;

  next
}

int wayland_display_connect() {
  int scratch_len = 128;
  char *scratch = malloc(scratch_len);
  map_string *env = parse_env();

  *scratch = "XDG_RUNTIME_DIR\0";
  char *xdg_runtime_dir = map_string_get(env, scratch);
  assert(xdg_runtime_dir != NULL, __LINE__);
  int xdg_runtime_dir_len = strlen(xdg_runtime_dir);

  *scratch = "WAYLAND_DISPLAY\0";
  char *wayland_display = map_string_get(env, scratch);

  if (wayland_display == NULL) {
    auto wayland_display_default = "wayland-0\0";
    assert(xdg_runtime_dir_len + 1 + sizeof_packed(wayland_display_default) <=
               scratch_len,
           __LINE__);

    char *next = strcpy(scratch, xdg_runtime_dir);
    *next = '/';
    *(next + 1) = wayland_display_default;
  } else {
    char *next = strcpy(scratch, xdg_runtime_dir);
    *next = '/';
    strcpy(next + 1, wayland_display);
  }

  sockaddr_wrapped addr = mk_unix_sockaddr(scratch);
  free(scratch);

  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
  connect(fd, addr.addr, addr.len);

  fd
}

int wayland_wl_display_get_registry(int fd) {
  buf *buffer = buf_new(128);

  buf_write_u32(buffer, wayland_display_object_id);
  buf_write_u16(buffer, wayland_wl_display_get_registry_opcode);

  /* int msg_announced_size = */
  /*     wayland_header_size + sizeof(wayland_current_id); */
  int msg_announced_size = wayland_header_size + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size, __LINE__);
  buf_write_u16(buffer, msg_announced_size);

  int id = next_wayland_id();
  buf_write_u32(buffer, id);

  if (buffer->size != send(fd, buffer->buf, buffer->size, 0)) {
    quit();
  }

  /* printf("-> wl_display@%u.get_registry: wl_registry=%u\n", */
  /*        wayland_display_object_id, wayland_current_id); */

  buf_free(buffer);

  id
}

int wayland_wl_registry_bind(int fd, int registry, int name, char *interface,
                             int interface_len, int version) {
  buf *buffer = buf_new(512);
  buf_write_u32(buffer, registry);

  buf_write_u16(buffer, wayland_wl_registry_bind_opcode);

  /* int msg_announced_size = wayland_header_size + sizeof(name) + */
  /*                          sizeof(interface_len) + roundup_4(interface_len) +
   */
  /*                          sizeof(version) + sizeof(wayland_current_id); */
  int msg_announced_size =
      wayland_header_size + 4 + 4 + roundup_4(interface_len) + 4 + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size, __LINE__);
  buf_write_u16(buffer, msg_announced_size);

  buf_write_u32(buffer, name);
  buf_write_lp_string_padded(buffer, interface, interface_len);
  buf_write_u32(buffer, version);

  int id = next_wayland_id();
  buf_write_u32(buffer, id);

  assert(buffer->size == roundup_4(buffer->size), __LINE__);

  if (buffer->size != send(fd, buffer->buf, buffer->size, 0)) {
    quit();
  }

  /* printf("-> wl_registry@%u.bind: name=%u interface=%.*s version=%u\n", */
  /*        registry, name, interface_len, interface, version); */

  buf_free(buffer);

  id
}

int wayland_wl_compositor_create_surface(int fd, state_t *state) {
  assert(state->wl_compositor > 0, __LINE__);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->wl_compositor);

  buf_write_u16(buffer, wayland_wl_compositor_create_surface_opcode);

  /* uint16_t msg_announced_size = */
  /*     wayland_header_size + sizeof(wayland_current_id); */
  int msg_announced_size = wayland_header_size + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size, __LINE__);
  buf_write_u16(buffer, msg_announced_size);

  int id = next_wayland_id();
  buf_write_u32(buffer, id);

  if (buffer->size != send(fd, buffer->buf, buffer->size, 0)) {
    quit();
  }

  /* printf("-> wl_compositor@%u.create_surface: wl_surface=%u\n", */
  /*        state->wl_compositor, wayland_current_id); */

  buf_free(buffer);

  id
}

void create_shared_memory_file(int size, state_t *state) {
  auto memfd_name = "framebuffer\0";
  char *memfd_name_ptr = malloc(sizeof(memfd_name));
  *memfd_name_ptr = memfd_name;

  int fd = memfd_create(memfd_name_ptr, 0);
  ftruncate(fd, size);

  state->shm_pool_data =
      mmap(NULL, size, PROT_READ + PROT_WRITE, MAP_SHARED, fd, 0);
  assert(state->shm_pool_data != NULL, __LINE__);

  state->shm_fd = fd;

  free(memfd_name_ptr);
}

