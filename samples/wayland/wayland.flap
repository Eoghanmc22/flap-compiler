void wayland_wl_surface_commit(int fd, state_t *state) {
  assert(state->wl_surface > 0, __LINE__);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->wl_surface);

  buf_write_u16(buffer, wayland_wl_surface_commit_opcode);

  int msg_announced_size = wayland_header_size;
  assert(roundup_4(msg_announced_size) == msg_announced_size, __LINE__);
  buf_write_u16(buffer, msg_announced_size);

  if (buffer->size != send(fd, buffer->buf, buffer->size, 0)) {
    quit();
  }

  /* printf("-> wl_surface@%u.commit: \n", state->wl_surface); */

  buf_free(buffer);
}

void wayland_handle_message(int fd, state_t *state, buf *buffer) {
  assert(buffer->size >= 8, __LINE__);

  int object_id = buf_read_u32(buffer);
  assert(object_id <= *wayland_current_id_ptr, __LINE__);

  int opcode = buf_read_u16(buffer);

  int announced_size = buf_read_u16(buffer);
  assert(roundup_4(announced_size) <= announced_size, __LINE__);

  /* int header_size = sizeof(object_id) + sizeof(opcode) +
   * sizeof(announced_size); */
  int header_size = 4 + 2 + 2;
  assert(announced_size <= header_size + buffer->size, __LINE__);

  if (object_id == state->wl_registry &&
      opcode == wayland_wl_registry_event_global) {
    print(424242);
    int name = buf_read_u32(buffer);
    print(name);

    int interface_len = buf_read_u32(buffer);
    print(interface_len);
    int padded_interface_len = roundup_4(interface_len);
    print(padded_interface_len);

    char *interface = state->scratch;
    char *scratch = state->scratch + padded_interface_len;
    print_str(interface);
    assert(padded_interface_len <= state->scratch_len, __LINE__);

    buf_read_n(buffer, interface, padded_interface_len);
    // The length includes the NULL terminator.
    write(STDOUT, interface, interface_len);
    assert(interface[interface_len - 1] == (char)0, __LINE__);

    int version = buf_read_u32(buffer);

    /* printf("<- wl_registry@%u.global: name=%u interface=%.*s version=%u\n",
     */
    /*        state->wl_registry, name, interface_len, interface, version); */

    /* assert(announced_size == sizeof(object_id) + sizeof(announced_size) + */
    /*                              sizeof(opcode) + sizeof(name) + */
    /*                              sizeof(interface_len) + padded_interface_len
     * + */
    /*                              sizeof(version)); */
    assert(announced_size == 4 + 2 + 2 + 4 + 4 + padded_interface_len + 4,
           __LINE__);

    *scratch = "wl_shm";
    if (strcmp(scratch, interface) == 0) {
      state->wl_shm = wayland_wl_registry_bind(
          fd, state->wl_registry, name, interface, interface_len, version);
    }

    *scratch = "xdg_wm_base";
    if (strcmp(scratch, interface) == 0) {
      state->xdg_wm_base = wayland_wl_registry_bind(
          fd, state->wl_registry, name, interface, interface_len, version);
    }

    *scratch = "wl_compositor";
    if (strcmp(scratch, interface) == 0) {
      state->wl_compositor = wayland_wl_registry_bind(
          fd, state->wl_registry, name, interface, interface_len, version);
    }
  } else if (object_id == wayland_display_object_id &&
             opcode == wayland_wl_display_error_event) {
    int target_object_id = buf_read_u32(buffer);
    int code = buf_read_u32(buffer);

    char *error = state->scratch;
    int error_len = buf_read_u32(buffer);
    buf_read_n(buffer, error, roundup_4(error_len));

    /* fprintf(stderr, "fatal error: target_object_id=%u code=%u error=%s\n", */
    /* target_object_id, code, error); */
    quit();
  } else if (object_id == state->wl_shm &&
             opcode == wayland_shm_pool_event_format) {

    int format = buf_read_u32(buffer);
    /* printf("<- wl_shm: format=%#x\n", format); */
  } else if (object_id == state->wl_buffer &&
             opcode == wayland_wl_buffer_event_release) {
    // No-op, for now.

    /* printf("<- xdg_wl_buffer@%u.release\n", state->wl_buffer); */
  } else if (object_id == state->xdg_wm_base &&
             opcode == wayland_xdg_wm_base_event_ping) {
    int ping = buf_read_u32(buffer);
    /* printf("<- xdg_wm_base@%u.ping: ping=%u\n", state->xdg_wm_base, ping); */
    wayland_xdg_wm_base_pong(fd, state, ping);
  } else if (object_id == state->xdg_toplevel &&
             opcode == wayland_xdg_toplevel_event_configure) {
    int w = buf_read_u32(buffer);
    int h = buf_read_u32(buffer);
    int len = buf_read_u32(buffer);
    buf_advance_read(buffer, len);

    /* printf("<- xdg_toplevel@%u.configure: w=%u h=%u states[%u]\n", */
    /* state->xdg_toplevel, w, h, len); */
  } else if (object_id == state->xdg_surface &&
             opcode == wayland_xdg_surface_event_configure) {
    int configure = buf_read_u32(buffer);
    /* printf("<- xdg_surface@%u.configure: configure=%u\n", state->xdg_surface,
     */
    /*        configure); */
    wayland_xdg_surface_ack_configure(fd, state, configure);
    state->state = STATE_SURFACE_ACKED_CONFIGURE;
  } else if (object_id == state->xdg_toplevel &&
             opcode == wayland_xdg_toplevel_event_close) {
    /* printf("<- xdg_toplevel@%u.close\n", state->xdg_toplevel); */
    quit();
  } else {
    /* fprintf(stderr, "object_id=%u opcode=%u buffer->size=%lu\n", object_id,
     * opcode, */
    /*         *buffer->size); */
    /* assert(0 && "todo"); */
  }
}

void handle_messages(int fd, buf *read_buf, state_t *state) {
  if (read_buf->size > 0) {
    wayland_handle_message(fd, state, read_buf);
    handle_messages(fd, read_buf, state);
  }
}

