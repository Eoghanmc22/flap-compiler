/* #define cstring_len(s) (sizeof(s) - 1) */
/* #define roundup_4(n) (((n) + 3) & -4) */

static uint32_t wayland_current_id = 1;

const int *wayland_current_id_ptr = (int *)GLOBAL_START;
const char *NEXT_GLOBAL = NEXT_GLOBAL + PAGE_SIZE; //roundup_page_size(sizeof<rng>);
map_global((void *)wayland_current_id_ptr, sizeof<int>);

const int wayland_display_object_id = 1;
const int wayland_wl_registry_event_global = 0;
const int wayland_shm_pool_event_format = 0;
const int wayland_wl_buffer_event_release = 0;
const int wayland_xdg_wm_base_event_ping = 0;
const int wayland_xdg_toplevel_event_configure = 0;
const int wayland_xdg_toplevel_event_close = 1;
const int wayland_xdg_surface_event_configure = 0;
const int wayland_wl_display_get_registry_opcode = 1;
const int wayland_wl_registry_bind_opcode = 0;
const int wayland_wl_compositor_create_surface_opcode = 0;
const int wayland_xdg_wm_base_pong_opcode = 3;
const int wayland_xdg_surface_ack_configure_opcode = 4;
const int wayland_wl_shm_create_pool_opcode = 0;
const int wayland_xdg_wm_base_get_xdg_surface_opcode = 2;
const int wayland_wl_shm_pool_create_buffer_opcode = 0;
const int wayland_wl_surface_attach_opcode = 1;
const int wayland_xdg_surface_get_toplevel_opcode = 1;
const int wayland_wl_surface_commit_opcode = 6;
const int wayland_wl_display_error_event = 0;
const int wayland_format_xrgb8888 = 1;
const int wayland_header_size = 8;
const int color_channels = 4;

typedef int state_state_t;
const int STATE_NONE = 0;
const int STATE_SURFACE_ACKED_CONFIGURE = 1;
const int STATE_SURFACE_ATTACHED = 2;

typedef struct {
  int wl_registry;
  int wl_shm;
  int wl_shm_pool;
  int wl_buffer;
  int xdg_wm_base;
  int xdg_surface;
  int wl_compositor;
  int wl_surface;
  int xdg_toplevel;
  int stride;
  int w;
  int h;
  int shm_pool_size;
  int shm_fd;
  char *shm_pool_data;
  char *scratch;
  int scratch_len;

  state_state_t state;
} state_t;

int next_wayland_id() {
  int next = *wayland_current_id_ptr + 1;
  *wayland_current_id_ptr = next;

  next
}

int wayland_display_connect() {
  char *xdg_runtime_dir = getenv("XDG_RUNTIME_DIR");
  assert(xdg_runtime_dir == NULL, __LINE__);

  int xdg_runtime_dir_len = strlen(xdg_runtime_dir);

  struct sockaddr_un addr = {.sun_family = AF_UNIX};
  assert(xdg_runtime_dir_len <= cstring_len(addr.sun_path), __LINE__);
  int socket_path_len = 0;

  memcpy_char(addr.sun_path, xdg_runtime_dir, xdg_runtime_dir_len);
  int socket_path_len = socket_path_len + xdg_runtime_dir_len;

  addr.sun_path[socket_path_len++] = '/';

  char *wayland_display = getenv("WAYLAND_DISPLAY");
  int socket_path_len = if (wayland_display == (char *)NULL) {
    auto wayland_display_default = "wayland-0";
    int wayland_display_default_len = sizeof_packed(wayland_display_default);

    memcpy(addr.sun_path + socket_path_len, wayland_display_default,
           wayland_display_default_len);

    socket_path_len + wayland_display_default_len
  }
  else {
    int wayland_display_len = strlen(wayland_display);
    memcpy(addr.sun_path + socket_path_len, wayland_display,
           wayland_display_len);

    socket_path_len + wayland_display_len
  };

  int fd = socket(AF_UNIX, SOCK_STREAM, 0);
  connect(fd, (struct sockaddr *)&addr, sizeof(addr));

  fd
}

int wayland_wl_display_get_registry(int fd) {
  buf *buffer = buf_new(128);

  buf_write_u32(buffer, wayland_display_object_id);
  buf_write_u16(buffer, wayland_wl_display_get_registry_opcode);

  /* int msg_announced_size = */
  /*     wayland_header_size + sizeof(wayland_current_id); */
  int msg_announced_size = wayland_header_size + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  int id = next_wayland_id();
  buf_write_u32(buffer, id);

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> wl_display@%u.get_registry: wl_registry=%u\n", */
  /*        wayland_display_object_id, wayland_current_id); */

  buf_free(buffer);

  id
}

int wayland_wl_registry_bind(int fd, int registry, int name, char *interface,
                             int interface_len, int version) {
  buf *buffer = buf_new(512);
  buf_write_u32(buffer, registry);

  buf_write_u16(buffer, wayland_wl_registry_bind_opcode);

  /* int msg_announced_size = wayland_header_size + sizeof(name) + */
  /*                          sizeof(interface_len) + roundup_4(interface_len) +
   */
  /*                          sizeof(version) + sizeof(wayland_current_id); */
  int msg_announced_size =
      wayland_header_size + 4 + 4 + roundup_4(interface_len) + 4 + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  buf_write_u32(buffer, name);
  buf_write_string(buffer, interface, interface_len);
  buf_write_u32(buffer, version);

  int id = next_wayland_id();
  buf_write_u32(buffer, id);

  assert(msg_size == roundup_4(msg_size));

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> wl_registry@%u.bind: name=%u interface=%.*s version=%u\n", */
  /*        registry, name, interface_len, interface, version); */

  buf_free(buffer);

  id
}

int wayland_wl_compositor_create_surface(int fd, state_t *state) {
  assert(state->wl_compositor > 0);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->wl_compositor);

  buf_write_u16(buffer, wayland_wl_compositor_create_surface_opcode);

  /* uint16_t msg_announced_size = */
  /*     wayland_header_size + sizeof(wayland_current_id); */
  int msg_announced_size = wayland_header_size + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  int id = next_wayland_id();
  buf_write_u32(buffer, id);

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> wl_compositor@%u.create_surface: wl_surface=%u\n", */
  /*        state->wl_compositor, wayland_current_id); */

  buf_free(buffer);

  id
}

int create_shared_memory_file(int size, state_t *state) {
  int fd = memfd_create("framebuffer", 0);
  ftruncate(fd, size);

  state->shm_pool_data =
      mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
  assert(state->shm_pool_data != NULL);

  state->shm_fd = fd;
}

void wayland_xdg_wm_base_pong(int fd, state_t *state, int ping) {
  assert(state->xdg_wm_base > 0);
  assert(state->wl_surface > 0);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->xdg_wm_base);

  buf_write_u16(buffer, wayland_xdg_wm_base_pong_opcode);

  /* int msg_announced_size = wayland_header_size + sizeof(ping); */
  int msg_announced_size = wayland_header_size + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  buf_write_u32(buffer, ping);

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> xdg_wm_base@%u.pong: ping=%u\n", state->xdg_wm_base, ping); */

  buf_free(buffer);
}

void wayland_xdg_surface_ack_configure(int fd, state_t *state, int configure) {
  assert(state->xdg_surface > 0);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->xdg_surface);

  buf_write_u16(buffer, wayland_xdg_surface_ack_configure_opcode);

  /* int msg_announced_size = wayland_header_size + sizeof(configure); */
  int msg_announced_size = wayland_header_size + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  buf_write_u32(buffer, configure);

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> xdg_surface@%u.ack_configure: configure=%u\n",
   * state->xdg_surface, */
  /*        configure); */

  buf_free(buffer);
}

int wayland_wl_shm_create_pool(int fd, state_t *state) {
  assert(state->shm_pool_size > 0);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->wl_shm);

  buf_write_u16(buffer, wayland_wl_shm_create_pool_opcode);

  /* uint16_t msg_announced_size = wayland_header_size + */
  /*                               sizeof(wayland_current_id) + */
  /*                               sizeof(state->shm_pool_size); */
  int msg_announced_size = wayland_header_size + 4 + 4;

  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  int id = next_wayland_id();
  buf_write_u32(buffer, id);

  buf_write_u32(buffer, state->shm_pool_size);

  assert(roundup_4(msg_size) == msg_size);

  // Send the file descriptor as ancillary data.
  // UNIX/Macros monstrosities ahead.
  char buf[CMSG_SPACE(sizeof(state->shm_fd))] = "";

  struct iovec io = {.iov_base = msg, .iov_len = msg_size};
  struct msghdr socket_msg = {
      .msg_iov = &io,
      .msg_iovlen = 1,
      .msg_control = buf,
      .msg_controllen = sizeof(buf),
  };

  struct cmsghdr *cmsg = CMSG_FIRSTHDR(&socket_msg);
  cmsg->cmsg_level = SOL_SOCKET;
  cmsg->cmsg_type = SCM_RIGHTS;
  cmsg->cmsg_len = CMSG_LEN(sizeof(state->shm_fd));

  *((int *)CMSG_DATA(cmsg)) = state->shm_fd;
  socket_msg.msg_controllen = CMSG_SPACE(sizeof(state->shm_fd));

  sendmsg(fd, &socket_msg, 0);

  /* printf("-> wl_shm@%u.create_pool: wl_shm_pool=%u\n", state->wl_shm, */
  /*        wayland_current_id); */

  buf_free(buffer);

  id
}

int wayland_xdg_wm_base_get_xdg_surface(int fd, state_t *state) {
  assert(state->xdg_wm_base > 0);
  assert(state->wl_surface > 0);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->xdg_wm_base);

  buf_write_u16(buffer, wayland_xdg_wm_base_get_xdg_surface_opcode);

  /* uint16_t msg_announced_size = wayland_header_size + */
  /*                               sizeof(wayland_current_id) + */
  /*                               sizeof(state->wl_surface); */
  int msg_announced_size = wayland_header_size + 4 + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  int id = next_wayland_id();
  buf_write_u32(buffer, wayland_current_id);

  buf_write_u32(buffer, state->wl_surface);

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> xdg_wm_base@%u.get_xdg_surface: xdg_surface=%u
   * wl_surface=%u\n", */
  /*        state->xdg_wm_base, wayland_current_id, state->wl_surface); */

  buf_free(buffer);

  id
}

int wayland_wl_shm_pool_create_buffer(int fd, state_t *state) {
  assert(state->wl_shm_pool > 0);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->wl_shm_pool);

  buf_write_u16(buffer, wayland_wl_shm_pool_create_buffer_opcode);

  /* int msg_announced_size = */
  /*     wayland_header_size + sizeof(wayland_current_id) + sizeof(uint32_t) *
   * 5; */
  int msg_announced_size = wayland_header_size + 4 + 4 * 5;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  int id = next_wayland_id();
  buf_write_u32(buffer, id);

  int offset = 0;
  buf_write_u32(buffer, offset);
  buf_write_u32(buffer, state->w);
  buf_write_u32(buffer, state->h);
  buf_write_u32(buffer, state->stride);

  int format = wayland_format_xrgb8888;
  buf_write_u32(buffer, format);

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> wl_shm_pool@%u.create_buffer: wl_buffer=%u\n",
   * state->wl_shm_pool, */
  /*        wayland_current_id); */

  buf_free(buffer);

  id
}

void wayland_wl_surface_attach(int fd, state_t *state) {
  assert(state->wl_surface > 0);
  assert(state->wl_buffer > 0);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->wl_surface);

  buf_write_u16(buffer, wayland_wl_surface_attach_opcode);

  /* int msg_announced_size = */
  /*     wayland_header_size + sizeof(state->wl_buffer) + sizeof(uint32_t) * 2;
   */
  int msg_announced_size = wayland_header_size + 4 + 4 * 2;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  buf_write_u32(buffer, state->wl_buffer);

  int x = 0;
  int y = 0;
  buf_write_u32(buffer, x);
  buf_write_u32(buffer, y);

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> wl_surface@%u.attach: wl_buffer=%u\n", state->wl_surface, */
  /*        state->wl_buffer); */

  buf_free(buffer);
}

int wayland_xdg_surface_get_toplevel(int fd, state_t *state) {
  assert(state->xdg_surface > 0);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->xdg_surface);

  buf_write_u16(buffer, wayland_xdg_surface_get_toplevel_opcode);

  /* int msg_announced_size = */
  /*     wayland_header_size + sizeof(wayland_current_id); */
  int msg_announced_size = wayland_header_size + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  int id = next_wayland_id();
  buf_write_u32(buffer, int);

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> xdg_surface@%u.get_toplevel: xdg_toplevel=%u\n", */
  /*        state->xdg_surface, wayland_current_id); */

  buf_free(buffer);

  id
}

static void wayland_wl_surface_commit(int fd, state_t *state) {
  assert(state->wl_surface > 0);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->wl_surface);

  buf_write_u16(buffer, wayland_wl_surface_commit_opcode);

  int msg_announced_size = wayland_header_size;
  assert(roundup_4(msg_announced_size) == msg_announced_size);
  buf_write_u16(buffer, msg_announced_size);

  if (msg_size != send(fd, msg, msg_size, 0)) {
    quit();
  }

  /* printf("-> wl_surface@%u.commit: \n", state->wl_surface); */

  buf_free(buffer);
}

static void wayland_handle_message(int fd, state_t *state, buf *buffer) {
  assert(*msg_len >= 8);

  int object_id = buf_read_u32(buffer);
  assert(object_id <= wayland_current_id);

  int opcode = buf_read_u16(buffer);

  int announced_size = buf_read_u16(buffer);
  assert(roundup_4(announced_size) <= announced_size);

  /* int header_size = sizeof(object_id) + sizeof(opcode) +
   * sizeof(announced_size); */
  int header_size = 4 + 4 + 4;
  assert(announced_size <= header_size + *msg_len);

  if (object_id == state->wl_registry &&
      opcode == wayland_wl_registry_event_global) {
    int name = buf_read_u32(buffer);

    int interface_len = buf_read_u32(buffer);
    int padded_interface_len = roundup_4(interface_len);

    char *interface = state->scratch;
    assert(padded_interface_len <= cstring_len(interface));

    buf_read_n(buffer, interface, padded_interface_len);
    // The length includes the NULL terminator.
    assert(interface[interface_len - 1] == 0);

    int version = buf_read_u32(msg, msg_len);

    /* printf("<- wl_registry@%u.global: name=%u interface=%.*s version=%u\n",
     */
    /*        state->wl_registry, name, interface_len, interface, version); */

    /* assert(announced_size == sizeof(object_id) + sizeof(announced_size) + */
    /*                              sizeof(opcode) + sizeof(name) + */
    /*                              sizeof(interface_len) + padded_interface_len
     * + */
    /*                              sizeof(version)); */
    assert(announced_size == 4 + 2 + 2 + 4 + 4 + padded_interface_len + 4);

    auto wl_shm_interface = "wl_shm";
    if (strcmp(wl_shm_interface, interface) == 0) {
      state->wl_shm = wayland_wl_registry_bind(
          fd, state->wl_registry, name, interface, interface_len, version);
    }

    auto xdg_wm_base_interface = "xdg_wm_base";
    if (strcmp(xdg_wm_base_interface, interface) == 0) {
      state->xdg_wm_base = wayland_wl_registry_bind(
          fd, state->wl_registry, name, interface, interface_len, version);
    }

    auto wl_compositor_interface = "wl_compositor";
    if (strcmp(wl_compositor_interface, interface) == 0) {
      state->wl_compositor = wayland_wl_registry_bind(
          fd, state->wl_registry, name, interface, interface_len, version);
    }
  } else if (object_id == wayland_display_object_id &&
             opcode == wayland_wl_display_error_event) {
    int target_object_id = buf_read_u32(msg, msg_len);
    int code = buf_read_u32(msg, msg_len);

    char *error = state->scratch;
    int error_len = buf_read_u32(msg, msg_len);
    buf_read_n(msg, msg_len, error, roundup_4(error_len));

    /* fprintf(stderr, "fatal error: target_object_id=%u code=%u error=%s\n", */
    /* target_object_id, code, error); */
    quit();
  } else if (object_id == state->wl_shm &&
             opcode == wayland_shm_pool_event_format) {

    int format = buf_read_u32(msg, msg_len);
    /* printf("<- wl_shm: format=%#x\n", format); */
  } else if (object_id == state->wl_buffer &&
             opcode == wayland_wl_buffer_event_release) {
    // No-op, for now.

    /* printf("<- xdg_wl_buffer@%u.release\n", state->wl_buffer); */
  } else if (object_id == state->xdg_wm_base &&
             opcode == wayland_xdg_wm_base_event_ping) {
    int ping = buf_read_u32(msg, msg_len);
    /* printf("<- xdg_wm_base@%u.ping: ping=%u\n", state->xdg_wm_base, ping); */
    wayland_xdg_wm_base_pong(fd, state, ping);
  } else if (object_id == state->xdg_toplevel &&
             opcode == wayland_xdg_toplevel_event_configure) {
    int w = buf_read_u32(msg, msg_len);
    int h = buf_read_u32(msg, msg_len);
    int len = buf_read_u32(msg, msg_len);
    buf_advance_read()

    /* printf("<- xdg_toplevel@%u.configure: w=%u h=%u states[%u]\n", */
    /* state->xdg_toplevel, w, h, len); */
  } else if (object_id == state->xdg_surface &&
             opcode == wayland_xdg_surface_event_configure) {
    int configure = buf_read_u32(msg, msg_len);
    /* printf("<- xdg_surface@%u.configure: configure=%u\n", state->xdg_surface,
     */
    /*        configure); */
    wayland_xdg_surface_ack_configure(fd, state, configure);
    state->state = STATE_SURFACE_ACKED_CONFIGURE;
  } else if (object_id == state->xdg_toplevel &&
             opcode == wayland_xdg_toplevel_event_close) {
    /* printf("<- xdg_toplevel@%u.close\n", state->xdg_toplevel); */
    quit();
  } else {
    /* fprintf(stderr, "object_id=%u opcode=%u msg_len=%lu\n", object_id,
     * opcode, */
    /*         *msg_len); */
    /* assert(0 && "todo"); */
  }
}

void handle_messages(buf *read_buf, state_t *state) {
  if (read_buf->size > 0) {
    wayland_handle_message(fd, &state, &msg, &msg_len);
    handle_messages(read_buf, state);
  }
}

void render_frame(char *frame_buffer, int idx, state_t *state) {
  // TODO:

  /* for (uint32_t i = 0; i < state.w * state.h; i++) { */
  /*   uint8_t r = wayland_logo[i * 3 + 0]; */
  /*   uint8_t g = wayland_logo[i * 3 + 1]; */
  /*   uint8_t b = wayland_logo[i * 3 + 2]; */
  /*   pixels[i] = (r << 16) | (g << 8) | b; */
  /* } */
}

void main_loop(buf *read_buf, state_t *state) {
  read_buf->size = recv(fd, read_buf->buf, read_buf->cap, 0);

  handle_messages(read_buf, state);

  if (state.wl_compositor != 0 && state.wl_shm != 0 && state.xdg_wm_base != 0 &&
      state.wl_surface == 0) {
    // Bind phase complete, need to create surface.
    assert(state.state == STATE_NONE);

    state.wl_surface = wayland_wl_compositor_create_surface(fd, state);
    state.xdg_surface = wayland_xdg_wm_base_get_xdg_surface(fd, state);
    state.xdg_toplevel = wayland_xdg_surface_get_toplevel(fd, state);
    wayland_wl_surface_commit(fd, state);
  }

  if (state.state == STATE_SURFACE_ACKED_CONFIGURE) {
    // Render a frame.
    assert(state.wl_surface != 0);
    assert(state.xdg_surface != 0);
    assert(state.xdg_toplevel != 0);

    if (state.wl_shm_pool == 0) {
      state.wl_shm_pool = wayland_wl_shm_create_pool(fd, state);
    }
    if (state.wl_buffer == 0) {
      state.wl_buffer = wayland_wl_shm_pool_create_buffer(fd, state);
    }

    assert(state.shm_pool_data != 0);
    assert(state.shm_pool_size != 0);

    char *pixels = state.shm_pool_data;
    render_frame(pixels, 0, state);

    wayland_wl_surface_attach(fd, state);
    wayland_wl_surface_commit(fd, state);

    state.state = STATE_SURFACE_ATTACHED;
  }

  buf_reset(read_buf);

  main_loop(read_buf, state);
}

int main() {
  int fd = wayland_display_connect();
  int scratch_len = 4096;

  state_t *state = (state_t *)malloc(sizeof<state_t>);
  *state = struct {
    wl_registry = wayland_wl_display_get_registry(fd);
    wl_shm = 0;
    wl_shm_pool = 0;
    wl_buffer = 0;
    xdg_wm_base = 0;
    xdg_surface = 0;
    wl_compositor = 0;
    wl_surface = 0;
    xdg_toplevel = 0;
    stride = 0;
    w = 117;
    h = 150;
    stride = 117 * color_channels;
    shm_poll_size = 0;
    shm_fd = 0;
    shm_pool_data = (char *)NULL;
    scratch = (char *)malloc(scratch_len);
    scratch_len = scratch_len;
  };

  // Single buffering.
  state.shm_pool_size = state.h * state.stride;
  create_shared_memory_file(state.shm_pool_size, &state);

  buf *read_buf = buf_new(4096);
  main_loop(read_buf, state);
}
