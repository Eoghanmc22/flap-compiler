  assert(state->xdg_wm_base > 0, __LINE__);
  assert(state->wl_surface > 0, __LINE__);

  buf *buffer = buf_new(128);
  buf_write_u32(buffer, state->xdg_wm_base);

  buf_write_u16(buffer, wayland_xdg_wm_base_pong_opcode);

  /* int msg_announced_size = wayland_header_size + sizeof(ping); */
  int msg_announced_size = wayland_header_size + 4;
  assert(roundup_4(msg_announced_size) == msg_announced_size, __LINE__);
  buf_write_u16(buffer, msg_announced_size);

  buf_write_u32(buffer, ping);

  if (buffer->size != send(fd, buffer->buf, buffer->size, 0)) {
    quit();
  }

  /* printf("-> xdg_wm_base@%u.pong: ping=%u\n", state->xdg_wm_base, ping); */

  buf_free(buffer);
}

