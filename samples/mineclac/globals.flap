#include "../../std/"

// Server configuration
const int PORT = 25565;
const int MAX_PLAYERS = 2000;
const int MAX_MOBS = 16;
const int MOB_DESPAWN_DISTANCE = 256;
const int GAMEMODE = 1;
const int VIEW_DISTANCE = 2;
const int TICKS_PER_SECOND = 20;
const int TIME_BETWEEN_TICKS = 1000000 / TICKS_PER_SECOND;
const int TICK_AHEAD_MICROS = 300;
const int INITIAL_WORLD_SEED = 0x67;
const int INITIAL_RNG_SEED = 0x42;
const int CHUNK_SIZE = 8;
const int TERRAIN_BASE_HEIGHT = 60;
const int CAVE_BASE_DEPTH = 24;
const int BIOME_SIZE = 64;
const int BIOME_RADIUS = 32;
const int VISITED_HISTORY = 4;
const int MAX_BLOCK_CHANGES = 20000;
const int DISK_SYNC_INTERVAL = 15000000;
const int NETWORK_TIMEOUT_TIME = 15000000;
const int MAX_RECV_BUF_LEN = 256;

// Damage type indices (generated by build_registries.js from damage_type registry).
// Replace with actual values once registries are generated.
const int D_generic  = 0;
const int D_fall     = 1;
const int D_lava     = 2;
const int D_cactus   = 3;
const int D_on_fire  = 4;

// Protocol connection states
const int STATE_NONE = 0;
const int STATE_STATUS = 1;
const int STATE_LOGIN = 2;
const int STATE_TRANSFER = 3;
const int STATE_CONFIGURATION = 4;
const int STATE_PLAY = 5;

// PlayerData flags
const int FLAG_ATTACK_COOLDOWN   = 0x01;
const int FLAG_NOT_SPAWNED       = 0x02;
const int FLAG_SNEAKING          = 0x04;
const int FLAG_SPRINTING         = 0x08;
const int FLAG_EATING            = 0x10;
const int FLAG_CLIENT_LOADING    = 0x20;
const int FLAG_MOVEMENT_COOLDOWN = 0x40;
const int FLAG_CRAFT_LOCK        = 0x80;

// ---- Global mutable state ----

// Receive scratch buffer — allocated in main before any I/O
int recv_count = 0;
char *recv_buffer = (char *)0;
char *idek_buffer = (char *)0;

int world_seed = INITIAL_WORLD_SEED;
int rng_seed = INITIAL_RNG_SEED;

int world_time = 0;
int server_ticks = 0;
int client_count = 0;
int block_changes_count = 0;
int player_data_count = 0;

// Initialized by init_globals() — string literals can't coerce to char * directly
char *motd = (char *)0;
int motd_len = 0;

char *brand_channel = (char *)0;
int brand_channel_len = 0;

char *brand = (char *)0;
int brand_len = 0;

char *dim_overworld = (char *)0;
char *str_left_game = (char *)0;
char *str_joined_game = (char *)0;
char *str_block_limit = (char *)0;
char *str_crafting = (char *)0;
char *str_furnace = (char *)0;
char *str_death_fall_high = (char *)0;
char *str_death_fall = (char *)0;
char *str_death_lava = (char *)0;
char *str_death_mob = (char *)0;
char *str_death_player = (char *)0;
char *str_death_cactus = (char *)0;
char *str_death_generic = (char *)0;
char *str_help_msg = (char *)0;
char *str_unknown_cmd = (char *)0;
char *str_help_cmd = (char *)0;

// ---- Struct types ----

typedef struct {
    int x;
    int z;
    int y;
    int block;
} BlockChange;

// Inventory slot: item ID + count packed into two ints.
// (C used uint16_t + uint8_t; we use int for each.)
typedef struct {
    int item;
    int count;
} Slot;

// Player state. Large sub-arrays (inventory, uuid, name, visited chunks)
// are kept as pointers and allocated per-player at login.
typedef struct {
    char *uuid;           // 16 bytes
    char *name;           // up to 16 bytes, null-terminated
    int client_fd;
    int x;
    int y;
    int z;
    int *visited_x;       // VISITED_HISTORY ints
    int *visited_z;       // VISITED_HISTORY ints
    int yaw;
    int pitch;
    int grounded_y;
    int health;
    int hunger;
    int saturation;
    int hotbar;
    int *inventory_items; // 41 item IDs
    int *inventory_count; // 41 counts
    int *craft_items;     // 9 item IDs
    int *craft_count;     // 9 counts
    int flagval_16;
    int flagval_8;
    int flags;
    int packets_since_update;
    int state;
} PlayerData;

typedef struct {
    int type;
    int x;
    int y;
    int z;
    int data; // lower 5: health; bit 5: sheared; upper 2: panic timer
} MobData;

typedef struct {
    int index;
    int type;   // 0 = Byte, 21 = Pose
    int value;
} EntityData;

typedef struct {
    int x;
    int z;
    int hash;
    int biome;
} ChunkAnchor;

typedef struct {
    int x;
    int y;
    int z;
    int variant;
} ChunkFeature;

// Per-connection state table: [fd, state, fd, state, ...], MAX_PLAYERS pairs.
// fd == -1 means the slot is free.
int *client_states = (int *)0;

// Counts bytes received across all clients (used by handlePacket to compute
// how many bytes a packet handler actually consumed).
int total_bytes_received = 0;

// Heap-allocated pools — initialised in init_globals()
BlockChange *block_changes = (BlockChange *)0;
PlayerData *player_data = (PlayerData *)0;
MobData *mob_data = (MobData *)0;

// Worldgen scratch buffers — (16/CHUNK_SIZE+1)^2 = 9 anchors, 4 features
char *chunk_section          = (char *)0;
ChunkAnchor *chunk_anchors   = (ChunkAnchor *)0;
ChunkFeature *chunk_features = (ChunkFeature *)0;
char *chunk_section_height   = (char *)0;

// Call once at program startup before any other server code.
// Allocates recv_buffer, pools, and string constants.
void init_globals() {
    recv_buffer   = malloc(MAX_RECV_BUF_LEN);
    idek_buffer   = malloc(MAX_RECV_BUF_LEN);
    client_states = malloc(MAX_PLAYERS * 2 * sizeof<int>);

    // Initialise all client slots to -1 (free)
    for (int ci = 0; ci < MAX_PLAYERS * 2; ci = ci + 1) {
        client_states[ci] = -1;
    }

    block_changes = malloc(sizeof<BlockChange> * MAX_BLOCK_CHANGES);
    player_data   = malloc(sizeof<PlayerData>  * MAX_PLAYERS);
    mob_data      = malloc(sizeof<MobData>     * MAX_MOBS);

    chunk_section        = malloc(4096);
    chunk_anchors        = malloc(sizeof<ChunkAnchor> * 9);
    chunk_features       = malloc(sizeof<ChunkFeature> * 4);
    chunk_section_height = malloc(256);

    auto motd_s = "A clacraft server\0";
    motd_len = sizeof_packed(motd_s) - 1;
    motd = malloc(motd_len + 1);
    *motd = motd_s;

    auto brand_channel_s = "minecraft:brand\0";
    brand_channel_len = sizeof_packed(brand_channel_s) - 1;
    brand_channel = malloc(brand_channel_len + 1);
    *brand_channel = brand_channel_s;

    auto brand_s = "bareiron-flap-on-clac-on-jit\0";
    brand_len = sizeof_packed(brand_s) - 1;
    brand = malloc(brand_len + 1);
    *brand = brand_s;

    auto dim_ow_s = "overworld\0";
    dim_overworld = malloc(10);
    *dim_overworld = dim_ow_s;

    auto slg_s = " left the game\0";
    str_left_game = malloc(15);
    *str_left_game = slg_s;

    auto sjg_s = " joined the game\0";
    str_joined_game = malloc(17);
    *str_joined_game = sjg_s;

    auto sbl_s = "Block changes limit exceeded. Restore original terrain to continue.\0";
    str_block_limit = malloc(68);
    *str_block_limit = sbl_s;

    auto scr_s = "Crafting\0";
    str_crafting = malloc(9);
    *str_crafting = scr_s;

    auto sfn_s = "Furnace\0";
    str_furnace = malloc(8);
    *str_furnace = sfn_s;

    auto sdfh_s = " fell from a high place\0";
    str_death_fall_high = malloc(24);
    *str_death_fall_high = sdfh_s;

    auto sdf_s = " hit the ground too hard\0";
    str_death_fall = malloc(25);
    *str_death_fall = sdf_s;

    auto sdl_s = " tried to swim in lava\0";
    str_death_lava = malloc(23);
    *str_death_lava = sdl_s;

    auto sdm_s = " was slain by a mob\0";
    str_death_mob = malloc(20);
    *str_death_mob = sdm_s;

    auto sdp_s = " was slain by \0";
    str_death_player = malloc(15);
    *str_death_player = sdp_s;

    auto sdc_s = " was pricked to death\0";
    str_death_cactus = malloc(22);
    *str_death_cactus = sdc_s;

    auto sdg_s = " died\0";
    str_death_generic = malloc(6);
    *str_death_generic = sdg_s;

    auto shm_s = "Commands:\n  !help - Show this help message\0";
    str_help_msg = malloc(42);
    *str_help_msg = shm_s;

    auto suc_s = "Unknown command\0";
    str_unknown_cmd = malloc(16);
    *str_unknown_cmd = suc_s;

    auto shc_s = "!help\0";
    str_help_cmd = malloc(6);
    *str_help_cmd = shc_s;
}
