// Crafting and smelting recipes.
#include "../../std/"
#include "tools.flap"
#include "registries.flap"

// Returns the crafting output for the 3x3 grid in player->craft_items[0..8].
// Slot.item == 0 means no recipe matched.
Slot getCraftingOutput(PlayerData *player) {
    Slot none = struct { item = 0; count = 0; };
    if ((player->flags & 0x80) != 0) { none }
    else {
        int filled = 0;
        int first = 10;
        int identical = 1;
        // Loop 1: count filled slots and find first non-empty index
        for (int i = 0; i < 9; i = i + 1) {
            if (player->craft_items[i] != 0) {
                filled = filled + 1;
                if (first == 10) { first = i; }
            }
        }
        // Loop 2: check if all non-empty slots have the same item
        if (filled > 1) {
            for (int i = 0; i < 9; i = i + 1) {
                if (player->craft_items[i] != 0 && player->craft_items[i] != player->craft_items[first]) {
                    identical = 0;
                }
            }
        }
        if (filled == 0) { none }
        else {
            int first_item = player->craft_items[first];
            int first_col = first % 3;
            int first_row = first / 3;

            if (filled == 1) {
                if (first_item == I_oak_log) { struct { item = I_oak_planks; count = 4; } }
                else if (first_item == I_oak_planks) { struct { item = I_oak_button; count = 1; } }
                else if (first_item == I_iron_block) { struct { item = I_iron_ingot; count = 9; } }
                else if (first_item == I_gold_block) { struct { item = I_gold_ingot; count = 9; } }
                else if (first_item == I_diamond_block) { struct { item = I_diamond; count = 9; } }
                else if (first_item == I_redstone_block) { struct { item = I_redstone; count = 9; } }
                else if (first_item == I_coal_block) { struct { item = I_coal; count = 9; } }
                else if (first_item == I_copper_block) { struct { item = I_copper_ingot; count = 9; } }
                else { none }

            } else if (filled == 2) {
                if (first_item == I_oak_planks) {
                    if (first_col != 2 && player->craft_items[first + 1] == I_oak_planks) {
                        struct { item = I_oak_pressure_plate; count = 1; }
                    } else if (first_row != 2 && player->craft_items[first + 3] == I_oak_planks) {
                        struct { item = I_stick; count = 4; }
                    } else { none }
                } else if (first_item == I_charcoal || first_item == I_coal) {
                    if (first_row != 2 && player->craft_items[first + 3] == I_stick) {
                        struct { item = I_torch; count = 4; }
                    } else { none }
                } else if (first_item == I_iron_ingot) {
                    if (
                        (first_row != 2 && first_col != 2 && player->craft_items[first + 4] == I_iron_ingot) ||
                        (first_row != 2 && first_col != 0 && player->craft_items[first + 2] == I_iron_ingot)
                    ) {
                        struct { item = I_shears; count = 1; }
                    } else { none }
                } else { none }

            } else if (filled == 3) {
                // Pre-compute shovel/sword results (used by slab materials via fall-through too)
                int shovel_item =
                    if (first_item == I_oak_planks) { I_wooden_shovel }
                    else if (first_item == I_cobblestone) { I_stone_shovel }
                    else if (first_item == I_iron_ingot) { I_iron_shovel }
                    else if (first_item == I_gold_ingot) { I_golden_shovel }
                    else if (first_item == I_diamond) { I_diamond_shovel }
                    else if (first_item == I_netherite_ingot) { I_netherite_shovel }
                    else { 0 };
                int sword_item =
                    if (first_item == I_oak_planks) { I_wooden_sword }
                    else if (first_item == I_cobblestone) { I_stone_sword }
                    else if (first_item == I_iron_ingot) { I_iron_sword }
                    else if (first_item == I_gold_ingot) { I_golden_sword }
                    else if (first_item == I_diamond) { I_diamond_sword }
                    else if (first_item == I_netherite_ingot) { I_netherite_sword }
                    else { 0 };
                // Slab materials: try slab recipe first, then fall through to tools
                if (first_item == I_oak_planks || first_item == I_cobblestone || first_item == I_stone || first_item == I_snow_block) {
                    if (first_col == 0 && player->craft_items[first + 1] == first_item && player->craft_items[first + 2] == first_item) {
                        int slab_item =
                            if (first_item == I_oak_planks) { I_oak_slab }
                            else if (first_item == I_cobblestone) { I_cobblestone_slab }
                            else if (first_item == I_stone) { I_stone_slab }
                            else { I_snow };
                        struct { item = slab_item; count = 6; }
                    } else if (first_row == 0 && player->craft_items[first + 3] == I_stick && player->craft_items[first + 6] == I_stick) {
                        struct { item = shovel_item; count = 1; }
                    } else if (first_row == 0 && player->craft_items[first + 3] == first_item && player->craft_items[first + 6] == I_stick) {
                        struct { item = sword_item; count = 1; }
                    } else { none }
                } else if (shovel_item != 0) {
                    if (first_row == 0 && player->craft_items[first + 3] == I_stick && player->craft_items[first + 6] == I_stick) {
                        struct { item = shovel_item; count = 1; }
                    } else if (first_row == 0 && player->craft_items[first + 3] == first_item && player->craft_items[first + 6] == I_stick) {
                        struct { item = sword_item; count = 1; }
                    } else { none }
                } else { none }

            } else if (filled == 4) {
                if (first_item == I_oak_planks || first_item == I_oak_log || first_item == I_snowball) {
                    if (first_col != 2 && first_row != 2 && player->craft_items[first + 1] == first_item && player->craft_items[first + 3] == first_item && player->craft_items[first + 4] == first_item) {
                        int result_item =
                            if (first_item == I_oak_planks) { I_crafting_table }
                            else if (first_item == I_oak_log) { I_oak_wood }
                            else { I_snow_block };
                        int result_count = if (first_item == I_oak_planks) { 1 } else { 3 };
                        struct { item = result_item; count = result_count; }
                    } else { none }
                } else if (first_item == I_leather || first_item == I_iron_ingot || first_item == I_gold_ingot || first_item == I_diamond || first_item == I_netherite_ingot) {
                    if (first_col == 0 && first_row < 2 && player->craft_items[first + 2] == first_item && player->craft_items[first + 3] == first_item && player->craft_items[first + 5] == first_item) {
                        int boot_item =
                            if (first_item == I_leather) { I_leather_boots }
                            else if (first_item == I_iron_ingot) { I_iron_boots }
                            else if (first_item == I_gold_ingot) { I_golden_boots }
                            else if (first_item == I_diamond) { I_diamond_boots }
                            else { I_netherite_boots };
                        struct { item = boot_item; count = 1; }
                    } else { none }
                } else { none }

            } else if (filled == 5) {
                // pick_item and axe_item are 0 for leather (which has no pickaxe/axe recipe)
                int pick_item =
                    if (first_item == I_oak_planks) { I_wooden_pickaxe }
                    else if (first_item == I_cobblestone) { I_stone_pickaxe }
                    else if (first_item == I_iron_ingot) { I_iron_pickaxe }
                    else if (first_item == I_gold_ingot) { I_golden_pickaxe }
                    else if (first_item == I_diamond) { I_diamond_pickaxe }
                    else if (first_item == I_netherite_ingot) { I_netherite_pickaxe }
                    else { 0 };
                int axe_item =
                    if (first_item == I_oak_planks) { I_wooden_axe }
                    else if (first_item == I_cobblestone) { I_stone_axe }
                    else if (first_item == I_iron_ingot) { I_iron_axe }
                    else if (first_item == I_gold_ingot) { I_golden_axe }
                    else if (first_item == I_diamond) { I_diamond_axe }
                    else if (first_item == I_netherite_ingot) { I_netherite_axe }
                    else { 0 };
                // helmet_item: 0 for planks/cobblestone (they cannot make helmets)
                int helmet_item =
                    if (first_item == I_leather) { I_leather_helmet }
                    else if (first_item == I_iron_ingot) { I_iron_helmet }
                    else if (first_item == I_gold_ingot) { I_golden_helmet }
                    else if (first_item == I_diamond) { I_diamond_helmet }
                    else if (first_item == I_netherite_ingot) { I_netherite_helmet }
                    else { 0 };
                if (pick_item != 0) {
                    // Pickaxe: row 0, [+1]=mat, [+2]=mat, [+4]=stick, [+7]=stick
                    if (first == 0 && player->craft_items[first + 1] == first_item && player->craft_items[first + 2] == first_item && player->craft_items[first + 4] == I_stick && player->craft_items[first + 7] == I_stick) {
                        struct { item = pick_item; count = 1; }
                    // Axe: first < 2, [+1]=mat, then either right-leaning or left-leaning L
                    } else if (first < 2 && player->craft_items[first + 1] == first_item && ((player->craft_items[first + 3] == first_item && player->craft_items[first + 4] == I_stick && player->craft_items[first + 7] == I_stick) || (player->craft_items[first + 4] == first_item && player->craft_items[first + 3] == I_stick && player->craft_items[first + 6] == I_stick))) {
                        struct { item = axe_item; count = 1; }
                    // Helmet falls through for non-planks/cobble materials
                    } else if (helmet_item != 0 && first_col == 0 && first_row < 2 && player->craft_items[first + 1] == first_item && player->craft_items[first + 2] == first_item && player->craft_items[first + 3] == first_item && player->craft_items[first + 5] == first_item) {
                        struct { item = helmet_item; count = 1; }
                    } else { none }
                } else if (helmet_item != 0) {
                    // Leather: helmet only
                    if (first_col == 0 && first_row < 2 && player->craft_items[first + 1] == first_item && player->craft_items[first + 2] == first_item && player->craft_items[first + 3] == first_item && player->craft_items[first + 5] == first_item) {
                        struct { item = helmet_item; count = 1; }
                    } else { none }
                } else { none }

            } else if (filled == 7) {
                int legging_item =
                    if (first_item == I_leather) { I_leather_leggings }
                    else if (first_item == I_iron_ingot) { I_iron_leggings }
                    else if (first_item == I_gold_ingot) { I_golden_leggings }
                    else if (first_item == I_diamond) { I_diamond_leggings }
                    else if (first_item == I_netherite_ingot) { I_netherite_leggings }
                    else { 0 };
                if (identical != 0 && player->craft_items[4] == 0 && player->craft_items[7] == 0 && legging_item != 0) {
                    struct { item = legging_item; count = 1; }
                } else if (first_item == I_oak_slab && identical != 0 && player->craft_items[1] == 0 && player->craft_items[4] == 0) {
                    struct { item = I_composter; count = 1; }
                } else { none }

            } else if (filled == 8) {
                if (identical != 0) {
                    if (player->craft_items[4] == 0) {
                        if (first_item == I_cobblestone) { struct { item = I_furnace; count = 1; } }
                        else if (first_item == I_oak_planks) { struct { item = I_chest; count = 1; } }
                        else { none }
                    } else if (player->craft_items[1] == 0) {
                        int chest_item =
                            if (first_item == I_leather) { I_leather_chestplate }
                            else if (first_item == I_iron_ingot) { I_iron_chestplate }
                            else if (first_item == I_gold_ingot) { I_golden_chestplate }
                            else if (first_item == I_diamond) { I_diamond_chestplate }
                            else if (first_item == I_netherite_ingot) { I_netherite_chestplate }
                            else { 0 };
                        if (chest_item != 0) { struct { item = chest_item; count = 1; } }
                        else { none }
                    } else { none }
                } else { none }

            } else if (filled == 9) {
                if (identical != 0) {
                    int block_item =
                        if (first_item == I_iron_ingot) { I_iron_block }
                        else if (first_item == I_gold_ingot) { I_gold_block }
                        else if (first_item == I_diamond) { I_diamond_block }
                        else if (first_item == I_redstone) { I_redstone_block }
                        else if (first_item == I_coal) { I_coal_block }
                        else if (first_item == I_copper_ingot) { I_copper_block }
                        else { 0 };
                    if (block_item != 0) { struct { item = block_item; count = 1; } }
                    else { none }
                } else { none }

            } else { none }
        }
    }
}

// Processes one furnace tick: consumes fuel and material, updates output slot.
// craft_items[0] = material, craft_items[1] = fuel, craft_items[2] = output.
// craft_count[0..2] are the corresponding stack sizes.
void getSmeltingOutput(PlayerData *player) {
    if (player->craft_count[0] == 0 || player->craft_count[1] == 0) {}
    else if (player->craft_items[0] == 0 || player->craft_items[1] == 0) {}
    else {
        int fuel = player->craft_items[1];
        int fuel_value =
            if (fuel == I_coal) { 8 }
            else if (fuel == I_charcoal) { 8 }
            else if (fuel == I_coal_block) { 80 }
            else if (fuel == I_oak_planks) { 1 + (fast_rand() & 1) }
            else if (fuel == I_oak_log) { 1 + (fast_rand() & 1) }
            else if (fuel == I_crafting_table) { 1 + (fast_rand() & 1) }
            else if (fuel == I_stick) { fast_rand() & 1 }
            else if (fuel == I_oak_sapling) { fast_rand() & 1 }
            else if (fuel == I_wooden_axe) { 1 }
            else if (fuel == I_wooden_pickaxe) { 1 }
            else if (fuel == I_wooden_shovel) { 1 }
            else if (fuel == I_wooden_sword) { 1 }
            else if (fuel == I_wooden_hoe) { 1 }
            else { -1 };

        if (fuel_value >= 0) {
            int mat = player->craft_items[0];
            int new_output =
                if (mat == I_cobblestone) { I_stone }
                else if (mat == I_oak_log) { I_charcoal }
                else if (mat == I_oak_wood) { I_charcoal }
                else if (mat == I_raw_iron) { I_iron_ingot }
                else if (mat == I_raw_gold) { I_gold_ingot }
                else if (mat == I_sand) { I_glass }
                else if (mat == I_chicken) { I_cooked_chicken }
                else if (mat == I_beef) { I_cooked_beef }
                else if (mat == I_porkchop) { I_cooked_porkchop }
                else if (mat == I_mutton) { I_cooked_mutton }
                else { 0 };

            if (new_output != 0 && (player->craft_items[2] == new_output || player->craft_items[2] == 0)) {
                int exchange = if (player->craft_count[0] > fuel_value) { fuel_value } else { player->craft_count[0] };
                player->craft_items[2] = new_output;
                player->craft_count[2] = player->craft_count[2] + exchange;
                player->craft_count[0] = player->craft_count[0] - exchange;
                player->craft_count[1] = player->craft_count[1] - 1;
                if (player->craft_count[1] == 0) {
                    player->craft_items[1] = 0;
                }
                if (player->craft_count[0] <= 0) {
                    player->craft_count[0] = 0;
                    player->craft_items[0] = 0;
                } else { getSmeltingOutput(player) }
            }
        }
    }
}
