#include "../std"

typedef struct {
  int a;
  char *b;
  int[5] x;
} inner;

typedef struct {
  int a;
  char *b;
  inner nested;
} test;

test it = struct {
  a = 20;
  b = (char *)NULL;
  nested = struct {
    a = 50;
    b = (char *)NULL;
    x = [ 1, 5, 2, 1, 3 ];
  };
};

test *heap = (test *)malloc(sizeof(it));
*heap = it;

print(heap->a);        // 20
print(heap->nested.a); // 50

heap->b = malloc(4096);
heap->nested.b = malloc(4096);

*(heap->b) = "hello world!\n\0";
*(heap->nested.b) = "hi from inner!\n\0";

heap->a = 30;
heap->nested.a = 60;

print(heap->a);        // 30
print(heap->nested.a); // 60

write(STDOUT, heap->b, strlen(heap->b));               // "hello world!"
write(STDOUT, heap->nested.b, strlen(heap->nested.b)); // "hi from inner!"

print((int)'i');
print((int)(heap->nested.b[1]));

print(heap->nested.x[0]);
print(heap->nested.x[1]);
print(heap->nested.x[2]);
print(heap->nested.x[3]);
print(heap->nested.x[4]);

test copy_back = *heap;

print(copy_back.nested.x[0]);
print(copy_back.nested.x[1]);
print(copy_back.nested.x[2]);
print(copy_back.nested.x[3]);
print(copy_back.nested.x[4]);

int[5] tmp = copy_back.nested.x;
heap->nested.x = [ tmp[0] + 1, tmp[1] + 1, tmp[2] + 1, tmp[3] + 1, tmp[4] + 1 ];

print(heap->nested.x[0]);
print(heap->nested.x[1]);
print(heap->nested.x[2]);
print(heap->nested.x[3]);
print(heap->nested.x[4]);

print((int)heap);
