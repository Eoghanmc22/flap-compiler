#include "../std"

map_string *env = parse_env();
map_string_iter *iter = map_string_iter_new(env);

void print_env(map_string_iter *iter) {
  if (map_string_iter_has_next(iter)) {
    map_string_entry entry = map_string_iter_next(iter);

    print_str(entry.key);
    print_str((char *)entry.value);
    print_new_line();

    print_env(iter);
  }
}
