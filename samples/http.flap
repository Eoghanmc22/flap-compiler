#include "../std"

const int BUFFER_SIZE = 4096;
const int PORT = 8080;

// Get the name of the file to serve
list_string *args = parse_args();
char *path = args->data[args->len - 1];

// Read the file into the buffer
int file_fd = open(path, 0, 0);
read_all2_result file = read_all2(file_fd);
close(file_fd);

// Create Socket
int server_fd = socket(AF_INET, SOCK_STREAM, 0);

// Temporary space for syscall args
char *scratch = malloc(16);

// Allow Socket Reuse
*((int *)scratch) = 1;
setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, scratch, int_width());

// Configure server address as 0.0.0.0:8080
*(scratch + 0) = (char)AF_INET;
*(scratch + 1) = (char)0;
*(scratch + 2) = (char)(PORT >> 8);
*(scratch + 3) = (char)(PORT & 0xFF);
*(scratch + 4) = (char)0;
*(scratch + 5) = (char)0;
*(scratch + 6) = (char)0;
*(scratch + 7) = (char)0;
*(scratch + 8) = (char)0;
*(scratch + 9) = (char)0;
*(scratch + 10) = (char)0;
*(scratch + 11) = (char)0;
*(scratch + 12) = (char)0;
*(scratch + 13) = (char)0;
*(scratch + 14) = (char)0;
*(scratch + 15) = (char)0;

// Start listing
bind(server_fd, (sockaddr *)scratch, 16);
listen(server_fd, 3);
free(scratch);

void handle_client(int client_fd, char *file_contents, int content_len) {
  auto header =
      "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: ";
  char *length = convert_int_to_string(content_len);
  auto tail = "\r\n\r\n";

  int header_len = sizeof_packed(header);
  int length_len = strlen(length);
  int tail_len = sizeof_packed(tail);

  int response_len = header_len + length_len + tail_len;
  char *response = malloc(response_len);

  *response = header;
  memcpy_char(response + header_len, length, length_len);
  *(response + header_len + length_len) = tail;

  write_all(client_fd, response, response_len);
  write_all(client_fd, file_contents, content_len);

  free(response);
  free(length);
}

// Client accept loop
void loop(int server_fd, char *file_contents, int content_len) {
  int client_fd = accept(server_fd, (sockaddr *)NULL, (int *)NULL);

  if (fork() == 0) {
    close(server_fd);
    handle_client(client_fd, file_contents, content_len);
    close(client_fd);

    quit();
  }
  close(client_fd);

  reap_children();

  loop(server_fd, file_contents, content_len);
}

loop(server_fd, file.data, file.len);
